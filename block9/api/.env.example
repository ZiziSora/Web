# Copy to .env yourself; never commit real credentials.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/postgres?schema=block9
PORT=3009
NODE_ENV=development
SPA_ORIGIN=http://localhost:5179
APP_BASE_URL=http://localhost:5179
# Three DIFFERENT random secrets, each at least 32 bytes; keep stable across restarts.
SESSION_SECRET=REPLACE_ME_WITH_RANDOM_SESSION_SECRET
AUTH_TOKEN_SECRET=REPLACE_ME_WITH_DIFFERENT_HMAC_SECRET
JWT_SECRET=REPLACE_ME_WITH_DIFFERENT_JWT_SECRET
# Token lifetimes in seconds. Rotation keeps the original refresh/session deadline.
ACCESS_TOKEN_TTL_SECONDS=600
REFRESH_TOKEN_TTL_SECONDS=28800
TRUST_PROXY_HOPS=0
RECAPTCHA_SECRET_KEY=REPLACE_ME_WITH_RECAPTCHA_V2_SECRET
SMTP_HOST=REPLACE_ME
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=REPLACE_ME
SMTP_PASS=REPLACE_ME
SMTP_FROM=REPLACE_ME
