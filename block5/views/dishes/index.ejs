<%- include('../partials/header') %>
<section class="menu-hero container">
  <div class="hero-copy">
    <p class="eyebrow"><span class="tiny-star" aria-hidden="true">✳</span> MỜI BẠN NGỒI XUỐNG</p>
    <h1>Vị quen thuộc.<br><em>Chút bất ngờ.</em></h1>
    <p class="hero-description">Từ căn bếp Việt đến những hương vị phương xa.<br class="desktop-break"> Một thực đơn để khám phá, một chiếc bàn để sẻ chia.</p>
    <a href="#menu" class="text-link">Khám phá thực đơn <span aria-hidden="true">↓</span></a>
  </div>
  <div class="hero-art" aria-hidden="true">
    <span class="art-label">A LITTLE TASTE OF EVERYTHING</span>
    <div class="plate"><div class="plate-inner"><span class="plate-star">✳</span><span class="plate-script">made with<br>love & care</span><span class="plate-small">THE TABLE KITCHEN</span></div></div>
    <div class="art-caption"><span>01 — TỪ CĂN BẾP CỦA CHÚNG TÔI</span><span class="art-arrow">↙</span></div>
  </div>
</section>
<div class="philosophy-strip"><div class="container philosophy-inner"><span>NGUYÊN LIỆU TỬ TẾ</span><i aria-hidden="true">✳</i><span>HƯƠNG VỊ CHÂN THÀNH</span><i aria-hidden="true">✳</i><span>NIỀM VUI QUANH BÀN ĂN</span></div></div>
<section class="menu-section container" id="menu" aria-labelledby="menu-heading">
  <div class="section-heading"><div><p class="eyebrow">CÓ GÌ NGON HÔM NAY?</p><h2 id="menu-heading">Thực đơn của chúng tôi<span class="accent">.</span></h2></div><span class="section-aside">Mỗi món ngon, một câu chuyện.</span></div>
  <div class="menu-toolbar">
    <p class="result-count"><span><%= dishes.length.toString().padStart(2, '0') %></span> <%= q ? 'món được tìm thấy' : 'món dành cho bạn' %></p>
    <form action="/dishes#menu" method="get" role="search" class="search-form">
      <label for="q" class="sr-only">Tìm món theo tên</label>
      <span class="search-icon" aria-hidden="true">⌕</span>
      <input id="q" name="q" type="search" value="<%= q %>" placeholder="Bạn đang muốn ăn gì?">
      <button type="submit">Tìm món <span aria-hidden="true">↗</span></button>
    </form>
  </div>
  <% if (q) { %><div class="search-summary"><p>Kết quả cho “<strong><%= q %></strong>”</p><a href="/dishes#menu">Xóa tìm kiếm <span aria-hidden="true">×</span></a></div><% } %>
  <% if (dishes.length) { %>
    <div class="dish-grid">
    <% dishes.forEach((dish, index) => { %>
      <article class="dish-card <%= !dish.available ? 'dish-unavailable' : '' %>">
        <div class="card-top"><span class="category"><%= dish.category %></span><span class="dish-number" aria-hidden="true"><%= String(index + 1).padStart(2, '0') %></span></div>
        <h3><a href="/dishes/<%= dish.id %>"><%= dish.name %></a></h3>
        <p class="dish-description"><%= dish.description %></p>
        <div class="card-bottom"><div><span class="dish-price"><%= money(dish.price) %></span><span class="availability <%= dish.available ? '' : 'unavailable' %>"><i aria-hidden="true"></i><%= dish.available ? 'Sẵn sàng phục vụ' : 'Tạm hết món' %></span></div><a class="circle-link" href="/dishes/<%= dish.id %>" aria-label="Xem chi tiết <%= dish.name %>">↗</a></div>
      </article>
    <% }) %>
    </div>
  <% } else { %>
    <div class="empty-state"><span class="empty-symbol" aria-hidden="true">✳</span><h3><%= q ? 'Chưa tìm thấy món bạn muốn.' : 'Thực đơn đang được chuẩn bị.' %></h3><p><%= q ? 'Thử một tên món khác hoặc khám phá lại toàn bộ thực đơn nhé.' : 'Những hương vị mới sẽ sớm có mặt tại chiếc bàn này.' %></p><% if(q) { %><a class="button" href="/dishes#menu">Xem tất cả món</a><% } %></div>
  <% } %>
  <div class="menu-endnote"><span aria-hidden="true">✳</span><p>Ngon hơn khi cùng nhau thưởng thức.</p><span aria-hidden="true">✳</span></div>
</section>
<%- include('../partials/footer') %>
