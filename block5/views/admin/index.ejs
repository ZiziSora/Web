<%- include('../partials/header') %>
<section class="container admin-content">
  <div class="section-heading"><div><p class="eyebrow"><%= labels[resource].eyebrow %> / QUẢN LÝ</p><h1><%= labels[resource].plural %><span class="accent">.</span></h1><p class="muted"><% if(resource === 'dishes') { %>Chăm chút từng món ngon trong thực đơn của bạn.<% } else if(resource === 'chefs') { %>Những người giữ lửa và kết nối các hương vị.<% } else { %>Khởi đầu của món ngon là nguyên liệu tử tế.<% } %></p></div><a class="button" href="/admin/<%= resource %>/new"><span aria-hidden="true">＋</span> Thêm <%= labels[resource].singular %></a></div>
  <% if(message) { %><div class="notice success" role="status"><span aria-hidden="true">✓</span> <%= message %></div><% } %>
  <div class="table-panel">
    <div class="table-caption"><span><%= labels[resource].plural %> trong danh mục</span><span class="count-pill"><%= entities.length %> bản ghi</span></div>
    <% if(entities.length) { %>
      <div class="table-scroll" role="region" aria-label="Bảng <%= labels[resource].singular %>" tabindex="0"><table>
        <thead><tr><th scope="col">Tên <%= labels[resource].singular %></th><% if(resource === 'dishes') { %><th scope="col">Danh mục</th><th scope="col">Giá</th><th scope="col">Trạng thái</th><% } else if(resource === 'chefs') { %><th scope="col">Chuyên môn</th><th scope="col">Món biết nấu</th><% } else { %><th scope="col">Đơn vị</th><th scope="col">Món sử dụng</th><% } %><th scope="col" class="actions-heading">Thao tác</th></tr></thead>
        <tbody><% for(const entity of entities) { %><tr>
          <th scope="row"><% if(resource === 'dishes') { %><a href="/dishes/<%= entity.id %>" class="entity-name"><%= entity.name %></a><% } else { %><span class="entity-name"><%= entity.name %></span><% } %><span class="record-id">#<%= String(entity.id).padStart(3, '0') %></span></th>
          <% if(resource === 'dishes') { %><td><span class="category"><%= entity.category %></span></td><td class="price-cell"><%= money(entity.price) %></td><td><span class="availability <%= entity.available ? '' : 'unavailable' %>"><i aria-hidden="true"></i><%= entity.available ? 'Đang phục vụ' : 'Tạm hết' %></span></td>
          <% } else if(resource === 'chefs') { %><td><%= entity.specialty %></td><td><div class="related-links"><% if(!entity.dishes.length) { %><span class="muted">Chưa liên kết món</span><% } %><% for(const dish of entity.dishes) { %><a href="/admin/dishes/<%= dish.id %>/edit"><%= dish.name %></a><% } %></div></td>
          <% } else { %><td><%= entity.unit %></td><td><div class="related-links"><% if(!entity.dishes.length) { %><span class="muted">Chưa dùng trong món</span><% } %><% for(const dish of entity.dishes) { %><a href="/admin/dishes/<%= dish.id %>/edit"><%= dish.name %></a><% } %></div></td><% } %>
          <td><div class="row-actions"><a href="/admin/<%= resource %>/<%= entity.id %>/edit" aria-label="Sửa <%= entity.name %>">Sửa <span aria-hidden="true">↗</span></a><a href="/admin/<%= resource %>/<%= entity.id %>/delete" class="danger-link" aria-label="Xóa <%= entity.name %>">Xóa</a></div></td>
        </tr><% } %></tbody>
      </table></div>
    <% } else { %><div class="empty-state"><span class="empty-symbol" aria-hidden="true">✳</span><h2>Chưa có <%= labels[resource].singular %>.</h2><p>Bắt đầu bằng cách thêm <%= labels[resource].singular %> đầu tiên.</p><a class="button secondary" href="/admin/<%= resource %>/new">Thêm <%= labels[resource].singular %></a></div><% } %>
  </div>
  <p class="admin-footnote"><span aria-hidden="true">✳</span> Mọi thay đổi được lưu và hiển thị trong thực đơn của nhà hàng.</p>
</section>
<%- include('../partials/footer') %>
