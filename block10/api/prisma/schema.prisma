generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

model Dish {
  searchName  String @default("") @ignore
  searchVector Unsupported("tsvector") @default(dbgenerated("''::tsvector"))
  id          Int          @id @default(autoincrement())
  name        String       @db.VarChar(120)
  description String       @db.VarChar(2000)
  price       Decimal      @db.Decimal(12, 2)
  category    String       @db.VarChar(80)
  available   Boolean      @default(true)
  chefs       Chef[]
  ingredients Ingredient[]
}

model Chef {
  searchName String @default("") @ignore
  id        Int    @id @default(autoincrement())
  name      String @db.VarChar(120)
  specialty String @db.VarChar(200)
  dishes    Dish[]
}

model Ingredient {
  searchName String @default("") @ignore
  id     Int    @id @default(autoincrement())
  name   String @db.VarChar(120)
  unit   String @db.VarChar(40)
  dishes Dish[]
}

model SecurityState {
  id String @id
  data Json
}

enum Role {
  viewer
  editor
  admin
}

model User {
  id              String   @id
  email           String   @unique @db.VarChar(254)
  passwordHash    String   @db.VarChar(60)
  role            Role     @default(viewer)
  status          String   @default("pending")
  emailVerifiedAt DateTime?
  userVersion     Int      @default(0)
  createdAt       DateTime @default(now())
  authSessions    AuthSession[]
}

model ActivationChallenge {
  id          String   @id // one challenge per user
  userId      String   @unique
  purpose     String
  otpHash     String
  expiresAt   DateTime
  attempts    Int      @default(0)
  lockedUntil DateTime?
  lastSentAt  DateTime
  usedAt      DateTime?
  @@index([expiresAt])
}

model PasswordReset {
  id        String   @id // one outstanding reset per user
  userId    String   @unique
  tokenHash String   @unique
  expiresAt DateTime
  usedAt    DateTime?
  @@index([expiresAt])
}

model Session {
  id        String   @id // SHA-256 of the opaque sid; never the cookie itself
  data      Json
  expiresAt DateTime
  @@index([expiresAt])
}

model AuthRateLimit {
  id          String   @id // HMAC of scope + normalized email/IP
  count       Int
  windowStart DateTime
  lockedUntil DateTime?
  @@index([windowStart])
}

model AuthSession {
  id             String @id
  userId         String
  user           User @relation(fields: [userId], references: [id])
  sessionVersion Int @default(0)
  createdAt      DateTime @default(now())
  expiresAt      DateTime
  revokedAt      DateTime?
  refreshTokens  RefreshToken[]
  @@index([userId])
  @@index([expiresAt])
}

model RefreshToken {
  id          String @id // SHA-256 of the opaque token
  sessionId   String
  session     AuthSession @relation(fields: [sessionId], references: [id])
  createdAt   DateTime @default(now())
  expiresAt   DateTime
  usedAt      DateTime?
  revokedAt   DateTime?
  replacedBy  String?
  @@index([sessionId])
  @@index([expiresAt])
}
