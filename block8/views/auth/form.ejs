<%- include('../partials/header') %>
<% const titles = {login:'Đăng nhập',register:'Tạo tài khoản',activate:'Kích hoạt',forgot:'Gửi hướng dẫn',reset:'Đổi mật khẩu'};
const pending = {login:'Đang đăng nhập…',register:'Đang tạo tài khoản…',activate:'Đang xác thực…',forgot:'Đang gửi email…',reset:'Đang đổi mật khẩu…'};
const icons = {login:'log-in',register:'user-plus',activate:'shield-check',forgot:'mail',reset:'key-round'};
%>
<section class="container auth-page">
  <div class="auth-panel">
    <div class="auth-heading-icon"><%- include('../partials/auth-icon', {name:icons[mode]}) %></div>
    <h1><%= pageTitle %></h1>
    <% if(message) { %><div class="auth-notice auth-notice--<%= messageTone %>" role="<%= messageTone === 'error' ? 'alert' : 'status' %>"><%- include('../partials/auth-icon', {name:messageTone === 'error' ? 'circle-alert' : messageTone === 'success' ? 'circle-check' : 'info'}) %><p><%= message %></p></div><% } %>
    <form action="/<%= mode %>" method="post" class="auth-form" data-auth-form>
      <input type="hidden" name="_csrf" value="<%= csrf %>">
      <% if(mode !== 'reset') { %>
      <div class="field"><label for="email">Email</label><div class="auth-input"><%- include('../partials/auth-icon', {name:'mail'}) %><input id="email" name="email" type="email" maxlength="254" autocomplete="email" placeholder="ban@example.com" value="<%= email %>" required></div></div>
      <% } %>
      <% if(['login','register','reset'].includes(mode)) { %>
      <div class="field">
        <div class="auth-label-row"><label for="password">Mật khẩu<%= mode === 'reset' ? ' mới' : '' %></label><% if(mode === 'login') { %><a href="/forgot">Quên mật khẩu?</a><% } %></div>
        <div class="auth-input auth-input--password">
          <%- include('../partials/auth-icon', {name:'lock-keyhole'}) %>
          <input id="password" name="password" type="password" autocomplete="<%= mode === 'login' ? 'current-password' : 'new-password' %>" required <%- mode !== 'login' ? 'aria-describedby="password-hint"' : '' %>>
          <button type="button" class="auth-password-toggle" data-password-toggle aria-label="Hiện mật khẩu" aria-controls="password" aria-pressed="false" hidden><span data-password-show><%- include('../partials/auth-icon', {name:'eye'}) %></span><span data-password-hide hidden><%- include('../partials/auth-icon', {name:'eye-off'}) %></span></button>
        </div>
        <% if(mode !== 'login') { %><p id="password-hint" class="field-hint">Tối thiểu 8 ký tự.</p><% } %>
      </div>
      <% } %>
      <% if(['register','reset'].includes(mode)) { %>
      <div class="field">
        <label for="password-confirm">Nhập lại mật khẩu</label>
        <div class="auth-input auth-input--password">
          <%- include('../partials/auth-icon', {name:'lock-keyhole'}) %>
          <input id="password-confirm" name="passwordConfirm" type="password" autocomplete="new-password" required aria-describedby="password-confirm-error" data-password-confirm>
          <button type="button" class="auth-password-toggle" data-password-toggle data-password-label="mật khẩu nhập lại" aria-label="Hiện mật khẩu nhập lại" aria-controls="password-confirm" aria-pressed="false" hidden><span data-password-show><%- include('../partials/auth-icon', {name:'eye'}) %></span><span data-password-hide hidden><%- include('../partials/auth-icon', {name:'eye-off'}) %></span></button>
        </div>
        <p id="password-confirm-error" class="field-error" aria-live="polite" hidden>Mật khẩu nhập lại không khớp.</p>
      </div>
      <% } %>
      <% if(mode === 'activate') { %>
      <div class="field"><label for="otp">Mã kích hoạt</label><div class="auth-input"><%- include('../partials/auth-icon', {name:'shield-check'}) %><input id="otp" name="otp" inputmode="numeric" autocomplete="one-time-code" pattern="[0-9]{6}" maxlength="6" placeholder="000000" required aria-describedby="otp-hint"></div><p id="otp-hint" class="field-hint">Nhập mã 6 chữ số trong email. Mã có hiệu lực 10 phút.</p></div>
      <% } %>
      <% if(captcha) { %>
      <div class="field captcha-field"><label for="captcha">Mã trong ảnh</label><div class="auth-captcha-image"><img src="<%= captcha.image %>" width="220" height="70" alt="Ảnh CAPTCHA gồm sáu ký tự"></div><div class="auth-input"><%- include('../partials/auth-icon', {name:'shield-check'}) %><input id="captcha" name="captcha" autocomplete="off" maxlength="12" required aria-describedby="captcha-hint"></div><input type="hidden" name="captchaId" value="<%= captcha.id %>"><p id="captcha-hint" class="field-hint">Tải lại trang để lấy mã mới.</p></div>
      <% } %>
      <%- include('../partials/auth-submit', {label:titles[mode], pendingLabel:pending[mode], secondary:false, icon:'arrow-right'}) %>
    </form>
    <% if(mode === 'activate') { %>
    <form action="/activate/resend" method="post" class="auth-form auth-resend-form" data-auth-form>
      <h2>Chưa nhận được mã?</h2><input type="hidden" name="_csrf" value="<%= csrf %>">
      <div class="field"><label for="resend-email">Email nhận lại mã</label><div class="auth-input"><%- include('../partials/auth-icon', {name:'mail'}) %><input id="resend-email" type="email" name="email" autocomplete="email" value="<%= email %>" required maxlength="254" aria-describedby="resend-hint"></div><p id="resend-hint" class="field-hint">Có thể gửi lại mã sau 60 giây.</p></div>
      <%- include('../partials/auth-submit', {label:'Gửi lại mã', pendingLabel:'Đang gửi email…', secondary:true, icon:'mail'}) %>
    </form>
    <% } %>
    <nav class="auth-links" aria-label="Tài khoản">
      <% if(mode === 'login') { %><p>Chưa có tài khoản? <a href="/register">Đăng ký</a></p><a class="auth-secondary-link" href="/activate">Kích hoạt tài khoản</a>
      <% } else if(mode === 'register') { %><p>Đã có tài khoản? <a href="/login">Đăng nhập</a></p>
      <% } else { %><a class="auth-back-link" href="/login"><%- include('../partials/auth-icon', {name:'arrow-left'}) %>Quay lại đăng nhập</a><% } %>
    </nav>
  </div>
</section>
<%- include('../partials/footer') %>
