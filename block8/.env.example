# Copy this template yourself to .env. Never commit real credentials.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/postgres?schema=block8
PORT=3008
NODE_ENV=development
APP_BASE_URL=http://localhost:3008
# Generate two DIFFERENT random secrets, each at least 32 bytes. Keep stable across restarts.
SESSION_SECRET=REPLACE_ME_WITH_RANDOM_SESSION_SECRET
AUTH_TOKEN_SECRET=REPLACE_ME_WITH_DIFFERENT_RANDOM_HMAC_SECRET
# 0 for direct access. Set the exact number of trusted proxy hops only when deployed behind a trusted proxy.
TRUST_PROXY_HOPS=0
SMTP_HOST=REPLACE_ME
SMTP_PORT=587
# false: STARTTLS required on 587. true: implicit TLS, normally port 465.
SMTP_SECURE=false
SMTP_USER=REPLACE_ME
SMTP_PASS=REPLACE_ME
SMTP_FROM=REPLACE_ME
# Optional absolute path to Chrome for browser tests on Windows.
# CHROME_PATH=C:/Program Files/Google/Chrome/Application/chrome.exe
